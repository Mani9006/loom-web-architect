{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "patch"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["patch_ready", "needs_human"]
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "patch": {
      "type": "string",
      "maxLength": 500000
    }
  }
}
