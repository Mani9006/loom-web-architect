# Frontend (Vite) environment template.
#
# Copy to .env.local for local development. Every VITE_* value is baked into the
# PUBLIC JavaScript bundle at build time: never put secrets here (no service-role
# keys, no provider API keys). Server-side secrets are Supabase secrets
# (`supabase secrets set NAME=...`); see docs/env-inventory.md for the full list.
#
# Keep this file in sync with the code: `node scripts/env-inventory.mjs --check`
# fails if a VITE_* variable the frontend reads is missing here.

# ── Supabase (required) ───────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias for the publishable key; read as a fallback by older call sites.
# VITE_SUPABASE_ANON_KEY=

# ── Environment ───────────────────────────────────────────────────────────
# One of: production | staging | development. Controls the env banner and
# which feature flags default on.
VITE_ENV=development

# ── Feature flags ─────────────────────────────────────────────────────────
# Default: ON in staging + development, OFF in production. "true"/"false" forces.
# VITE_ENABLE_RESUME_BUILDER_V2=
# VITE_ENABLE_JOB_SEARCH_STRICT=
# VITE_ENABLE_ENV_BANNER=

# ── Optional ──────────────────────────────────────────────────────────────
# Comma-separated owner emails that see admin UI (overrides the built-in list;
# the server still enforces access).
# VITE_ADMIN_OWNER_EMAILS=
# Endpoint that receives client analytics beacons; unset disables them.
# VITE_ANALYTICS_ENDPOINT=
# Commit SHA used to tag incident reports (defaults to "unknown"). Not set
# automatically: map it from Vercel's VERCEL_GIT_COMMIT_SHA in the project env.
# VITE_VERCEL_GIT_COMMIT_SHA=
