VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Environment — one of: production | staging | development
VITE_ENV=development

# Feature flags. Default: ON in staging+dev, OFF in production.
# VITE_ENABLE_RESUME_BUILDER_V2=true
# VITE_ENABLE_JOB_SEARCH_STRICT=true
# VITE_ENABLE_ENV_BANNER=true

# Optional analytics
# VITE_ANALYTICS_ENDPOINT=

# ---- Edge / worker (set in Supabase + worker, never in the Vite client) ----
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# PERPLEXITY_API_KEY=
# APPLYPASS_WORKER_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# APP_URL=https://resumepreps.com
#
# Gmail inbox OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GMAIL_TOKEN_ENCRYPTION_KEY=
#
# Outlook inbox OAuth (UI is live; handshake needs these)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=
#
# Job boards (connect only — never fake submit)
# INDEED_CLIENT_ID=
# INDEED_CLIENT_SECRET=
# NAUKRI_CLIENT_ID=
# NAUKRI_CLIENT_SECRET=
#
# Workday vault (worker-only)
# WORKDAY_VAULT_KEY=
#
# Mail send for compose-from apply address
# RESEND_API_KEY=
#
# Company / operator desk
# OWNER_EMAIL=myfamily9006@gmail.com
# ADMIN_OWNER_EMAILS=myfamily9006@gmail.com
# VITE_ADMIN_OWNER_EMAILS=myfamily9006@gmail.com
#
# Observability
# ALERT_WEBHOOK_URL=
# SENTRY_DSN=
#
# Test billing only — never enable in production
# ALLOW_TEST_SUBSCRIPTIONS=false
