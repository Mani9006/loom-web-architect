VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Apply-engine browser worker (scripts/applypass-browser-worker.mjs)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# APPLYPASS_WORKER_TOKEN=shared_with_applypass-agent-queue
# WORKER_AUTH_TOKEN=same_as_above_if_used
# APPLYPASS_WORKER_CONCURRENCY=4
# APPLYPASS_AUTO_SUBMIT=false

# Environment — one of: production | staging | development
# Controls the env banner + which feature flags default on.
VITE_ENV=development

# Feature flags. Default behavior: ON in staging+dev, OFF in production.
# Override with "true" / "false" to force.
# VITE_ENABLE_RESUME_BUILDER_V2=true
# VITE_ENABLE_JOB_SEARCH_STRICT=true
# VITE_ENABLE_ENV_BANNER=true
