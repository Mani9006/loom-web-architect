# Supabase Edge Function Environment Variables
# Copy this to supabase/.env and fill in your actual API keys

# REQUIRED: Perplexity API for real-time job search
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# HIGHLY RECOMMENDED: Exa.ai for neural job search
EXA_API_KEY=your_exa_api_key_here

# OPTIONAL: Mem0 for conversation memory
MEM0_API_KEY=your_mem0_api_key_here

# ──────────────────────────────────────────────────────────────────────────
# FREE-TIER LLM SETUP  ($0 — no paid OpenAI/Anthropic keys needed)
# ──────────────────────────────────────────────────────────────────────────
# All LLM features (resume tailoring + critic loop, ATS scoring, job-fit
# evaluation, email classification, bullet enhancement) route through the
# free provider chain in supabase/functions/_shared/free-llm.ts.
#
# The chain walks FREE_LLM_ORDER (default below), skipping providers without
# credentials and degrading to the next provider on 429/5xx/timeouts.
#
# 1) REQUIRED — Google AI Studio key (free: aistudio.google.com/apikey).
#    This single key runs the whole pipeline.
GEMINI_API_KEY=your_gemini_api_key_here
# OPTIONAL model overrides:
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL_LITE=gemini-2.5-flash-lite
#
# 2) OPTIONAL — Groq free tier (console.groq.com). Adds a fast second hop.
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL_LITE=llama-3.1-8b-instant
#
# 3) OPTIONAL — OpenRouter free models (openrouter.ai/keys). Third hop.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_MODEL_LITE=meta-llama/llama-3.3-70b-instruct:free
#
# 4) OPTIONAL — self-hosted Ollama (edge functions CANNOT reach localhost;
#    set an explicit reachable base URL, e.g. a tunnel or LAN host).
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:8b
#
# 5) OPTIONAL — chain order override (comma-separated; unknown names ignored):
# FREE_LLM_ORDER=gemini,groq,openrouter,ollama,openai,anthropic
#
# ──────────────────────────────────────────────────────────────────────────
# OPTIONAL PAID UPGRADES — used only as chain tail / when no free key exists
# ──────────────────────────────────────────────────────────────────────────
# OPTIONAL: OpenAI as fallback
OPENAI_API_KEY=your_openai_api_key_here

# OPTIONAL: Anthropic as fallback
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OPTIONAL: paid-path provider preference when only paid keys exist
# (openai | anthropic; default openai)
# LLM_DEFAULT_PROVIDER=openai
